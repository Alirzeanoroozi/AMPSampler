{
  "_comment": "Inhibitor-binder gates + ranking. Gates apply ONLY if the needed column exists in the manifest, so this runs even before the GPU stages. AMP-database similarity is intentionally absent (dropped as an objective).",

  "gates": {
    "catalytic_ok":          {"column": "catalytic_ok",        "equals": "True",  "reason": "must contact catalytic core"},
    "min_epitope_recall":    {"column": "epitope_recall",      "min": 0.15,       "reason": "meaningful active-site coverage"},
    "orthogonal_iptm":       {"column": ["af_iptm","boltz2_iptm","iptm"], "min": 0.6, "reason": "independent model agrees on pose"},
    "interface_ddg":         {"column": ["dG_separated","ddg"], "max": -10.0,     "reason": "energetically real interface"},
    "not_toxic":             {"column": ["Prediction","toxinpred_prediction"], "not_equals": "Toxin", "reason": "ToxinPred safety"},
    "hemolysis":             {"column": ["hemo_prob","Hemo"],  "max": 0.5,        "reason": "low predicted hemolysis"},
    "max_liabilities":       {"column": "n_liabilities",       "max": 2,          "reason": "few synthesis liabilities"},
    "aggregation":           {"column": "aggregation_proxy",   "max": 2.5,        "reason": "not aggregation-prone"},
    "length":                {"column": "length",              "min": 12, "max": 45, "reason": "synthesisable peptide length"}
  },

  "ranking_weights": {
    "epitope_recall":        1.0,
    "n_catalytic_contacts":  1.0,
    "af_iptm":               0.8,
    "boltz2_iptm":           0.6,
    "boltz2_affinity_prob_binary": 0.8,
    "dG_separated":         -0.8,
    "delivery_proxy":        0.4,
    "n_liabilities":        -0.5,
    "aggregation_proxy":    -0.4
  },

  "diversity": {"max_pairwise_identity": 0.8, "comment": "cluster near-duplicates before final selection (Stage 5)"}
}
